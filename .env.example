# Server & Environment
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# Database (PostgreSQL with pgvector, or fallback sqlite:///./data/lenny.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_assistant
# For Docker Compose: postgresql://postgres:postgres@postgres:5432/lenny_assistant
# For Zero-Dependency local test without Postgres: sqlite:///./data/lenny.db

# Model Configuration
# Provider: 'anthropic' or 'ollama'
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Model (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
# When running inside Docker on Windows/Mac, set to: http://host.docker.internal:11434
OLLAMA_MODEL=phi3
OLLAMA_EMBED_MODEL=phi3

# Resilience & Fallback
# If true, retries query using Ollama if Anthropic API is rate-limited or fails
LLM_FALLBACK_TO_LOCAL=true
REQUEST_TIMEOUT_SECONDS=60

# RAG & Grounding Parameters
SIMILARITY_THRESHOLD=0.90
RETRIEVAL_TOP_K=6
